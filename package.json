{
  "name": "murmur",
  "version": "0.6.3",
  "private": true,
  "license": "MIT",
  "description": "Local-first dictation for macOS — hold a key, speak, release, polished text appears.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @murmur/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "native:build": "npm --prefix packages/native run build",
    "agent:server": "node scripts/agent/server.mjs",
    "agent": "node scripts/agent/cli.mjs",
    "audio-tap:build": "bash scripts/sidecars/build-audio-tap.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nut-tree-fork/nut-js": "4.2.6",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "playwright-core": "1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}

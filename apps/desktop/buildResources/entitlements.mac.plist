<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone capture in the hidden renderer (PLAN §5). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Electron requires these under the hardened runtime: V8 JIT. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- The bundled whisper-server / llama-server sidecars are signed
         separately and loaded at runtime (PLAN §4). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Deliberately absent: com.apple.security.app-sandbox. The CGEventTap
         hotkey listener and Accessibility text insertion are incompatible with
         the sandbox, which is why Murmur ships as a DMG and not via the App
         Store (PLAN §15). -->
</dict>
</plist>
